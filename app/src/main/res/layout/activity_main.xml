<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_deep">

    <!-- ═══════════════════════════════════════════ -->
    <!--              ONBOARDING SCREEN              -->
    <!-- ═══════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/onboardingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Hero Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0F1422">

                <!-- Gradient Circle Logo -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="20dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_logo_circle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🏋"
                        android:textSize="44sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingTop="24dp">

                <!-- Name Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_name"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_name"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="24dp" />

                <!-- Level Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_level"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="4dp" />

                <!-- Level Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/chipBeginner"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🌱 Αρχάριος"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_chip_selected"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipIntermediate"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="⚡ Μεσαίος"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_chip"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAdvanced"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🔥 Προχωρημένος"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_chip"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Goal Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_goal"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="4dp" />

                <!-- Goal Chips Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/chipMuscle"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="💪 Μυϊκή Ανάπτυξη"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_chip_selected"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipLoss"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🔥 Απώλεια Βάρους"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_chip"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Goal Chips Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="32dp">

                    <TextView
                        android:id="@+id/chipEndurance"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🏃 Αντοχή"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_chip"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipWellness"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🧘 Γενική Ευεξία"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_chip"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Start Button -->
                <TextView
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:text="Ξεκινάμε!"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:letterSpacing="0.02" />

                <!-- History Button -->
                <TextView
                    android:id="@+id/btnHistory"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="📋  Ιστορικό Συνομιλιών"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:background="@drawable/bg_card"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ═══════════════════════════════════════════ -->
    <!--               CHAT SCREEN                   -->
    <!-- ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/chatMainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Chat Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/bg_surface">

            <!-- Back Button -->
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:background="@drawable/bg_back_button"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <!-- Title + Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- User Badge -->
            <TextView
                android:id="@+id/tvUserBadge"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:background="@drawable/bg_chip_selected"
                android:maxLines="1" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Messages Area -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:fillViewport="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/chatLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </ScrollView>

        <!-- Typing Indicator -->
        <LinearLayout
            android:id="@+id/typingIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvTyping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Σκέφτομαι..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="italic" />

        </LinearLayout>

        <!-- Input Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/bg_surface">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:hint="@string/hint_message"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:background="@drawable/bg_input"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:maxLines="4"
                android:inputType="textMultiLine"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/btnSend"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="↑"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:background="@drawable/bg_send_button"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════════ -->
    <!--             HISTORY SCREEN                  -->
    <!-- ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/historyLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/bg_deep">

        <!-- History Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/bg_surface">

            <TextView
                android:id="@+id/btnHistoryBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:background="@drawable/bg_back_button"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ιστορικό Συνομιλιών"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/historyEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="48sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Δεν υπάρχουν αποθηκευμένες συνομιλίες"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- History List -->
        <ScrollView
            android:id="@+id/historyScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>
